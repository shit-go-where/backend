// Shit Go Where — data model. See PLAN.md §2.
// Schema changes ONLY through `pnpm prisma migrate dev --name <change>`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum VenueType {
  MRT_STATION
  BUS_INTERCHANGE
  MALL
  HAWKER_CENTRE
  COFFEESHOP
  COMMUNITY_CLUB
  PARK
  LIBRARY
  HOSPITAL
  SPORTS_CENTRE
  OTHER
}

enum VenueToiletStatus {
  HAS_TOILETS
  NONE
  UNKNOWN
  USES_NEARBY
}

enum DataSource {
  FIELDWORK_2024 // March 2024 pilot (men's toilets, 50-point rubric)
  FIELDWORK_2024_EXPANDED // Aug-Oct 2024 expanded survey (men's, women's, unisex; -3..+3 rubric)
  OSM
  ONEMAP
  DATAGOV
  WIKIDATA
  COMMUNITY
  ADMIN
}

/// Which score sheet a Survey row was filled in on (data/README.md).
enum SurveyRubric {
  PILOT_50 // cleanliness 0-10, scent/aesthetics/music/toiletries 0-5, facilities 0-20, total /50
  EXPANDED_2024 // cleanliness -3..+3, scent -2..+2, checklists; native values in Survey.breakdown
}

/// Which toilet a survey looked at: men's, women's or unisex (incl. handicapped).
enum SurveySex {
  MALE
  FEMALE
  UNISEX
}

enum ToiletTier {
  VERIFIED
  COMMUNITY
  IMPORTED
}

enum ToiletStatus {
  ACTIVE
  CLOSED
  RENOVATION
  PENDING
  REJECTED
}

enum AreaType {
  PAID_AREA
  UNPAID_AREA
  NOT_APPLICABLE
  UNKNOWN
}

enum Feature {
  TOILET_PAPER
  HAND_TOWEL
  HAND_DRYER
  HAND_SOAP
  SEAT_LINER
  BIDET
  AUTO_FLUSH
  AUTO_TAP
  AUTO_SOAP
  COAT_HOOK
  FEEDBACK_DEVICE
  SIGNAGE
  POSTERS
  AMBULANT
  ACCESSIBLE
  CHILD
  BABY_CHANGE
  NURSING_ROOM
  SHOWER
  SITTING
  SQUAT
  MALE
  FEMALE
  UNISEX
  FREE
  SANITARY_BIN
  PERIOD_PRODUCTS
  MIRROR
  WATER_REFILL
  ABLUTION
}

enum SubmissionKind {
  NEW_TOILET
  EDIT_TOILET
  CLOSE_TOILET
}

enum SubmissionState {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
  EXPIRED // legacy: expiry now escalates (ESCALATED) instead
  ESCALATED // nobody confirmed it in time, or an auto-published toilet was flagged: moderators decide
}

enum VoteValue {
  APPROVE
  REJECT
}

enum StatusKind {
  ALL_GOOD
  NO_PAPER
  NO_SOAP
  LONG_QUEUE
  BEING_CLEANED
  BROKEN
  CLOSED_NOW
}

enum Role {
  USER
  TRUSTED
  MODERATOR
  ADMIN
}

enum PointReason {
  SUBMISSION_APPROVED
  REVIEW_POSTED
  REVIEW_WITH_PHOTO
  STATUS_CONFIRMED
  CHECK_IN
  FIRST_CHECK_IN_AT_TOILET
  VOTE_MATCHED_OUTCOME
  SURVEY_COMPLETED
  NEW_TOILET_SUBMITTED // +5 when an on-site, photographed toilet goes live at once
  NEW_TOILET_CONFIRMED // +15 when a second person confirms it (5 + 15 = SUBMISSION_APPROVED's 20)
}

// ───────────────────────────── places ─────────────────────────────

model Venue {
  id           String            @id @default(cuid())
  name         String
  type         VenueType
  latitude     Float
  longitude    Float
  address      String?
  postalCode   String?
  planningArea String?
  lines        String[]
  toiletStatus VenueToiletStatus @default(UNKNOWN)
  note         String?
  openingHours Json?
  source       DataSource
  sourceKey    String            @unique
  externalIds  Json?
  toilets      Toilet[]
  submissions  Submission[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([latitude, longitude])
  @@index([type])
  @@index([planningArea])
}

model Toilet {
  id               String             @id @default(cuid())
  venueId          String
  venue            Venue              @relation(fields: [venueId], references: [id])
  label            String?
  latitude         Float
  longitude        Float
  // Normalised ("B1", "L3", "M", "B1; L3"): src/common/level.ts. Free text when it can't be read.
  level            String?
  // Sort key derived from level: B2 = -2, L1 = 1, M = 1.5, a list = its lowest; null when unknown.
  levelOrder       Float?
  areaType         AreaType           @default(UNKNOWN)
  nearestExit      String?
  accessNote       String?
  openingHours     Json?
  tier             ToiletTier
  status           ToiletStatus       @default(ACTIVE)
  source           DataSource
  sourceKey        String             @unique
  lastVerifiedAt   DateTime?
  needsResurvey    Boolean            @default(false)
  createdById      String?
  createdBy        User?              @relation("ToiletCreatedBy", fields: [createdById], references: [id])
  // Who last tapped "still accurate" on site (GROWTH.md 1.7). Shown by handle unless they opted out.
  lastVerifiedById String?
  lastVerifiedBy   User?              @relation("ToiletLastVerifiedBy", fields: [lastVerifiedById], references: [id], onDelete: SetNull)
  scoreCleanliness Float?
  reviewCount      Int                @default(0)
  // Distinct signed-in people who have been there: the submitter plus each first check-in within 150 m.
  seenBy           Int                @default(1)
  features         ToiletFeature[]
  surveys          Survey[]
  reviews          Review[]
  statusReports    StatusReport[]
  photos           Photo[]
  checkIns         CheckIn[]
  flags            Flag[]
  submissions      Submission[]
  routeDays        ToiletRouteDaily[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([latitude, longitude])
  @@index([status, tier])
  @@index([venueId, levelOrder])
}

model ToiletFeature {
  toiletId   String
  toilet     Toilet     @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  feature    Feature
  present    Boolean
  source     DataSource
  observedAt DateTime

  @@id([toiletId, feature])
  @@index([feature, present])
}

model Survey {
  id           String   @id @default(cuid())
  toiletId     String
  toilet       Toilet   @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  surveyedAt   DateTime
  surveyedById String?
  surveyedBy   User?    @relation(fields: [surveyedById], references: [id])
  rubric       SurveyRubric
  sex          SurveySex?
  phase        String?
  /// Normalised 0-10 for every rubric (feeds blendCleanliness); the native value is in `breakdown`.
  cleanliness  Float
  // PILOT_50 columns; null for other rubrics.
  scent        Int?
  aesthetics   Int?
  music        Int?
  toiletries   Int?
  facilities   Int?
  total        Int?
  rasStars     Int?
  /// Rubric-native values (EXPANDED_2024: see src/toilets/survey-items.ts). Null for PILOT_50.
  breakdown    Json?
  remarks      String?
  raw          Json
  createdAt    DateTime @default(now())

  @@index([toiletId, surveyedAt])
}

// ───────────────────────────── people ─────────────────────────────

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  googleSub          String?              @unique
  handle             String?              @unique
  displayName        String
  avatarUrl          String?
  role               Role                 @default(USER)
  trustScore         Int                  @default(0)
  // Listed on the leaderboard (handle and points). Opt-out; every live account has a handle.
  leaderboardOptIn   Boolean              @default(true)
  handleChangedAt    DateTime?
  // The handle was picked at random at sign-up (users/handle-gen.ts); changing away from it is free.
  handleAuto         Boolean              @default(false)
  lastSeenActivityAt DateTime?
  // Show "Last checked by @handle" on toilets this person verified (GROWTH.md 1.7). Opt-out.
  verifierCredit     Boolean              @default(true)
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  toiletsCreated     Toilet[]             @relation("ToiletCreatedBy")
  toiletsVerified    Toilet[]             @relation("ToiletLastVerifiedBy")
  submissions        Submission[]         @relation("SubmittedBy")
  resolved           Submission[]         @relation("ResolvedBy")
  votes              SubmissionVote[]
  reviews            Review[]
  statusReports      StatusReport[]
  statusConfirms     StatusConfirmation[]
  photos             Photo[]
  flags              Flag[]
  checkIns           CheckIn[]
  points             PointsLedger[]
  badges             UserBadge[]
  surveys            Survey[]
  photoApprovals     PhotoApproval[]
  // Telegram bot account linking (BOT.md T15). The token is a SHA-256 hash, valid 10 minutes, cleared on use.
  telegramChat       TelegramChat?
  telegramLinkTokenHash      String?
  telegramLinkTokenExpiresAt DateTime?
}

// ───────────────────────────── contributions ─────────────────────────────

model Submission {
  id             String           @id @default(cuid())
  kind           SubmissionKind
  state          SubmissionState  @default(PENDING)
  toiletId       String?
  toilet         Toilet?          @relation(fields: [toiletId], references: [id])
  venueId        String?
  venue          Venue?           @relation(fields: [venueId], references: [id])
  payload        Json
  submittedById  String
  submittedBy    User             @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedLat   Float?
  submittedLng   Float?
  // Submitted within 150 m of the pin / with at least one photo (trust model v2, PLAN.md §12 E1).
  onSite         Boolean          @default(false)
  hasPhoto       Boolean          @default(false)
  autoPublished  Boolean          @default(false)
  approvals      Int              @default(0)
  rejections     Int              @default(0)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?            @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolution     String? // stable code, see submissions/resolution.ts
  resolutionNote String? // free text from a moderator
  escalatedAt    DateTime?
  votes          SubmissionVote[]
  photos         Photo[]
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  @@index([state, createdAt])
  @@index([submittedLat, submittedLng])
  @@index([submittedById, createdAt])
}

model SubmissionVote {
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  value        VoteValue
  comment      String?
  distanceM    Int?
  weight       Int        @default(1)
  // Set when the vote came from a check-in at a pending toilet.
  checkInId    String?    @unique
  checkIn      CheckIn?   @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@id([submissionId, userId])
}

model Review {
  id          String   @id @default(cuid())
  toiletId    String
  toilet      Toilet   @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cleanliness Int
  comment     String?
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([toiletId, userId])
  @@index([toiletId, createdAt])
}

model StatusReport {
  id            String               @id @default(cuid())
  toiletId      String
  toilet        Toilet               @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  userId        String? // null = anonymous (deviceId set)
  user          User?                @relation(fields: [userId], references: [id])
  deviceId      String? // random id from the signed sgw_anon cookie, no PII
  kind          StatusKind
  confirmations Int                  @default(0)
  confirmedBy   StatusConfirmation[]
  createdAt     DateTime             @default(now())
  expiresAt     DateTime

  @@index([toiletId, expiresAt])
  @@index([toiletId, userId, kind, createdAt])
  @@index([deviceId, createdAt])
}

model StatusConfirmation {
  statusReportId String
  statusReport   StatusReport @relation(fields: [statusReportId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([statusReportId, userId])
}

model Photo {
  id           String          @id @default(cuid())
  key          String          @unique
  url          String
  thumbUrl     String?
  contentType  String
  toiletId     String?
  toilet       Toilet?         @relation(fields: [toiletId], references: [id], onDelete: SetNull)
  submissionId String?
  submission   Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reviewId     String?
  review       Review?         @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  confirmed    Boolean         @default(false)
  approved     Boolean         @default(false)
  approvals    Int             @default(0)
  approvedBy   PhotoApproval[]
  createdAt    DateTime        @default(now())

  @@index([toiletId, approved])
  @@index([approved, createdAt])
}

model PhotoApproval {
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([photoId, userId])
}

model Flag {
  id             String    @id @default(cuid())
  toiletId       String
  toilet         Toilet    @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  reason         String
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  /// The moderator's reply, shown to the reporter in /me (and sent by the bot if linked).
  resolutionNote String?
  createdAt      DateTime  @default(now())

  @@index([resolved, createdAt])
  @@index([userId, resolvedAt])
  @@index([toiletId, resolved])
}

// ───────────────────────────── gamification ─────────────────────────────

model CheckIn {
  id        String          @id @default(cuid())
  userId    String? // null = anonymous (deviceId set) until merged on sign-in
  user      User?           @relation(fields: [userId], references: [id])
  deviceId  String? // random id from the signed sgw_anon cookie, no PII
  toiletId  String
  toilet    Toilet          @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  distanceM Int
  vote      SubmissionVote?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([toiletId, createdAt])
  @@index([deviceId, createdAt])
}

model PointsLedger {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  delta     Int
  reason    PointReason
  refId     String
  createdAt DateTime    @default(now())

  @@unique([userId, reason, refId])
  @@index([userId])
  @@index([createdAt, userId])
}

model Badge {
  id          String      @id
  name        String
  description String
  icon        String
  rule        Json
  users       UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

// ───────────────────────────── ops ─────────────────────────────

model ImportRun {
  id         String     @id @default(cuid())
  source     DataSource
  command    String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  inserted   Int        @default(0)
  updated    Int        @default(0)
  skipped    Int        @default(0)
  log        Json?
}

// Small cache for things like the OneMap token, so cold serverless instances don't re-auth.
model KeyValue {
  key       String    @id
  value     Json
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
}

/// Routes started to a toilet, per Singapore day (GROWTH.md 1.3). Counts only: who routed is never stored.
model ToiletRouteDaily {
  toiletId String
  toilet   Toilet   @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  count    Int      @default(0)

  @@id([toiletId, day])
  @@index([day])
}

/// One row per Singapore day, written by the nightly `metrics` job (GROWTH.md 0.2).
model MetricsDaily {
  day           DateTime @id @db.Date
  /// Distinct contributors (users + anonymous devices) in the 7 days ending `day`.
  wac           Int
  /// Distinct contributors on `day`.
  contributors  Int
  checkIns      Int
  statusReports Int
  reviews       Int
  submissions   Int
  votes         Int
  /// % of ACTIVE Verified + Community toilets with lastVerifiedAt within 90 days.
  freshPct      Float
  /// ACTIVE toilets per tier: { VERIFIED, COMMUNITY, IMPORTED }.
  toiletsByTier Json
  pendingCount  Int
  createdAt     DateTime @default(now())
}

// ───────────────────────────── Telegram bot (BOT.md §6) ─────────────────────────────

enum TelegramChatType {
  PRIVATE
  GROUP
  SUPERGROUP
  CHANNEL
}

/// One row per chat that has used the bot. No names, usernames, phone numbers, message text or
/// coordinates. Deleted by /stop.
model TelegramChat {
  chatId      BigInt           @id
  type        TelegramChatType
  /// /go: the next location in this window ranks urgent.
  urgentUntil DateTime?
  /// Saved hard filters (/filters).
  filters     Feature[]        @default([])
  areaType    AreaType?
  openNow     Boolean          @default(false)
  /// Linked account (T15). Account deletion clears it.
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  /// Written at most once an hour.
  lastSeenAt  DateTime         @default(now())
}
