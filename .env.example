# Runtime connection (Neon: use the -pooler host). Local: docker compose db.
DATABASE_URL=postgresql://sgw:sgw@localhost:5433/sgw
# Direct connection for migrations and seeding (Neon: non-pooler host).
DIRECT_URL=postgresql://sgw:sgw@localhost:5433/sgw
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Public URL the browser uses to reach the API through the Next rewrite (used for OAuth redirect).
PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Cloudflare R2 via the S3 API. Omit S3_ENDPOINT to use AWS S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_EMAILS=you@example.com
CRON_SECRET=change-me
# Dev only: allows POST /auth/dev-login to sign in without Google.
DEV_LOGIN_ENABLED=true
SENTRY_DSN=
