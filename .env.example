# Runtime connection (Neon: use the -pooler host). Local: docker compose db.
DATABASE_URL=postgresql://sgw:sgw@localhost:5433/sgw
# Direct connection for migrations and seeding (Neon: non-pooler host). Also needed at Vercel BUILD time
# (`pnpm vercel-build` runs `prisma migrate deploy`). Neon's Vercel integration injects
# DATABASE_URL_UNPOOLED instead; prisma.config.ts and the CLI fall back to it.
DIRECT_URL=postgresql://sgw:sgw@localhost:5433/sgw
# Scratch database for `prisma migrate dev` / `migrate diff` (CI sets it; never set it on Vercel).
# SHADOW_DATABASE_URL=postgresql://sgw:sgw@localhost:5433/sgw_shadow
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Public URL the browser uses to reach the API through the Next rewrite (used for OAuth redirect and
# every link the bot sends). REQUIRED in production: set it to the final domain, e.g. https://shitgowhere.com.
PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Cloudflare R2 via the S3 API. Omit S3_ENDPOINT to use AWS S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Comma-separated; these accounts are promoted to ADMIN at every login.
ADMIN_EMAILS=you@example.com
# Same value as the GitHub secret CRON_SECRET (x-cron-secret header on /admin/jobs/*). Required in production.
CRON_SECRET=change-me
# Shared with the frontend (same value in both Vercel projects). The Next /api rewrite forwards each
# phone's IP in x-sgw-client-ip together with this secret; without it the API sees one Vercel IP for
# everyone and rate-limits them together. `openssl rand -hex 32`. Empty locally.
API_PROXY_SECRET=
# Dev only: allows POST /auth/dev-login to sign in without Google.
DEV_LOGIN_ENABLED=true
# Accepted by env.ts but not used anywhere yet: no error tracking is wired up.
SENTRY_DSN=
# PostHog EU project key for server-side events (GROWTH.md 0.1). Leave empty locally: nothing is sent.
POSTHOG_KEY=
# Default https://eu.i.posthog.com (EU cloud).
# POSTHOG_HOST=https://eu.i.posthog.com
# Telegram bot (BOT.md). Leave TELEGRAM_BOT_TOKEN empty to turn the bot off (no webhook route).
# Token from BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Random 32+ characters; registered by `pnpm cli telegram:setup` and checked on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @, used for t.me deep links and account linking.
TELEGRAM_BOT_USERNAME=shitgowherebot
# Broadcast channel (v1.5, not used yet).
TELEGRAM_CHANNEL_ID=
# Optional: point the bot at a stub Bot API (tests, local checks). Default https://api.telegram.org
# TELEGRAM_API_ROOT=http://localhost:8081
